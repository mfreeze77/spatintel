# syntax=docker/dockerfile:1.7
ARG PYTHON_IMAGE=python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64
FROM ${PYTHON_IMAGE} AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PIP_ROOT_USER_ACTION=ignore
WORKDIR /build
COPY pyproject.toml README.md LICENSE NOTICE.md ./
COPY src ./src
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade 'pip==25.1.1' \
 && /opt/venv/bin/pip install '.[postgres,redis,telemetry]'

FROM ${PYTHON_IMAGE} AS runtime
ARG SIP_BUILD_VERSION=1.1.0
ARG SIP_BUILD_REVISION=uncommitted
LABEL org.opencontainers.image.title="Spatial Intelligence Platform" \
      org.opencontainers.image.version="${SIP_BUILD_VERSION}" \
      org.opencontainers.image.revision="${SIP_BUILD_REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="local-build"
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SIP_ENV=production \
    SIP_ALLOW_DEVELOPMENT_AUTH=false \
    SIP_OBJECT_STORE_ROOT=/var/lib/sip/objects
RUN groupadd --gid 10001 sip \
 && useradd --uid 10001 --gid sip --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin sip \
 && mkdir -p /var/lib/sip/objects /var/lib/sip/runtime /app \
 && chown -R sip:sip /var/lib/sip /app
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY --chown=sip:sip alembic.ini ./
COPY --chown=sip:sip migrations ./migrations
COPY --chown=sip:sip schemas ./schemas
COPY --chown=sip:sip workers ./workers
COPY --chown=sip:sip infrastructure/containers/entrypoint.sh /usr/local/bin/sip-entrypoint
RUN chmod 0555 /usr/local/bin/sip-entrypoint
USER 10001:10001
VOLUME ["/var/lib/sip"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/sip-entrypoint"]
CMD ["uvicorn", "sip.api:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--no-server-header"]
