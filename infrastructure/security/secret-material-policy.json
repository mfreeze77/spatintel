{
  "schema": "sip.secret-material-policy/v1",
  "default": "deny",
  "forbidden_in_source": ["password", "token", "private_key", "passcode", "credential_secret", "biometric_value"],
  "allowed_references": ["vault://", "sip-asset://"],
  "runtime_source": "external_secret_manager",
  "audit_access": true
}
