{
  "co_location_allowed": true,
  "default_port": 8080,
  "health_paths": [
    "/health/live",
    "/health/ready",
    "/metrics"
  ],
  "logical_boundary": true,
  "operations": [
    {
      "method": "GET",
      "operation_id": "health_live",
      "path": "/health/live"
    },
    {
      "method": "GET",
      "operation_id": "health_ready",
      "path": "/health/ready"
    },
    {
      "method": "POST",
      "operation_id": "record_change_benchmark",
      "path": "/v1/projects/{project_id}/change-benchmarks"
    },
    {
      "method": "POST",
      "operation_id": "register_coordinate_frame",
      "path": "/v1/projects/{project_id}/coordinate-frames"
    },
    {
      "method": "POST",
      "operation_id": "convert_coordinate_units",
      "path": "/v1/projects/{project_id}/coordinate-frames/{frame_id}:convert-units"
    },
    {
      "method": "POST",
      "operation_id": "resolve_proxy_hit",
      "path": "/v1/projects/{project_id}/proxy-hits/resolve"
    },
    {
      "method": "POST",
      "operation_id": "create_scene",
      "path": "/v1/projects/{project_id}/scenes"
    },
    {
      "method": "POST",
      "operation_id": "remap_spatial_annotations",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/annotation-remaps"
    },
    {
      "method": "POST",
      "operation_id": "create_spatial_annotation",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/annotations"
    },
    {
      "method": "GET",
      "operation_id": "get_scene_as_of",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/as-of"
    },
    {
      "method": "POST",
      "operation_id": "create_scene_branch",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/branches"
    },
    {
      "method": "POST",
      "operation_id": "rollback_scene_branch",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/branches/{branch}/rollback"
    },
    {
      "method": "POST",
      "operation_id": "commit_scene",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/commits"
    },
    {
      "method": "POST",
      "operation_id": "create_scene_entity",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/entities"
    },
    {
      "method": "POST",
      "operation_id": "create_measurement",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/measurements"
    },
    {
      "method": "GET",
      "operation_id": "get_measurement",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/measurements/{measurement_id}"
    },
    {
      "method": "POST",
      "operation_id": "merge_scene_branches",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/merges"
    },
    {
      "method": "POST",
      "operation_id": "tag_scene_commit",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/tags"
    },
    {
      "method": "POST",
      "operation_id": "create_temporal_comparison",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/temporal-comparisons"
    },
    {
      "method": "GET",
      "operation_id": "get_temporal_comparison",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/temporal-comparisons/{comparison_id}"
    },
    {
      "method": "POST",
      "operation_id": "apply_accepted_changes",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/temporal-comparisons/{comparison_id}/apply"
    },
    {
      "method": "POST",
      "operation_id": "review_change_candidate",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/temporal-comparisons/{comparison_id}/candidates/{candidate_id}/reviews"
    },
    {
      "method": "POST",
      "operation_id": "create_viewer_session",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/viewer-sessions"
    },
    {
      "method": "GET",
      "operation_id": "get_viewer_session",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/viewer-sessions/{session_id}"
    },
    {
      "method": "POST",
      "operation_id": "replay_viewer_session",
      "path": "/v1/projects/{project_id}/scenes/{scene_id}/viewer-sessions/{session_id}/replays"
    },
    {
      "method": "POST",
      "operation_id": "register_spatial_transform",
      "path": "/v1/projects/{project_id}/spatial-transforms"
    },
    {
      "method": "GET",
      "operation_id": "resolve_spatial_transform",
      "path": "/v1/projects/{project_id}/spatial-transforms/resolve"
    },
    {
      "method": "GET",
      "operation_id": "diff_scene_commits",
      "path": "/v1/scene-diffs"
    }
  ],
  "required_environment": [
    "SIP_ENV",
    "SIP_DATABASE_URL",
    "SIP_OBJECT_STORE_BACKEND"
  ],
  "schema": "sip.service-manifest",
  "schema_version": "1.1.0",
  "security": {
    "development_auth_prohibited_in_production": true,
    "non_root_required": true,
    "read_only_root_filesystem_required": true
  },
  "service_name": "scene-service"
}
