{
  "co_location_allowed": true,
  "default_port": 8080,
  "health_paths": [
    "/health/live",
    "/health/ready",
    "/metrics"
  ],
  "logical_boundary": true,
  "operations": [
    {
      "method": "GET",
      "operation_id": "health_live",
      "path": "/health/live"
    },
    {
      "method": "GET",
      "operation_id": "health_ready",
      "path": "/health/ready"
    },
    {
      "method": "POST",
      "operation_id": "validate_agent_answer",
      "path": "/v1/projects/{project_id}/agent-answers:validate"
    },
    {
      "method": "POST",
      "operation_id": "check_agent_request",
      "path": "/v1/projects/{project_id}/agent-requests:check"
    },
    {
      "method": "GET",
      "operation_id": "list_agent_tools",
      "path": "/v1/projects/{project_id}/agent-tools"
    },
    {
      "method": "POST",
      "operation_id": "execute_agent_tool",
      "path": "/v1/projects/{project_id}/agent-tools/{tool_name}:execute"
    },
    {
      "method": "POST",
      "operation_id": "create_saved_query",
      "path": "/v1/projects/{project_id}/saved-queries"
    },
    {
      "method": "GET",
      "operation_id": "get_saved_query",
      "path": "/v1/projects/{project_id}/saved-queries/{saved_query_id}"
    },
    {
      "method": "POST",
      "operation_id": "execute_saved_query",
      "path": "/v1/projects/{project_id}/saved-queries/{saved_query_id}:execute"
    },
    {
      "method": "POST",
      "operation_id": "search_project",
      "path": "/v1/projects/{project_id}/search"
    },
    {
      "method": "POST",
      "operation_id": "index_search_document",
      "path": "/v1/projects/{project_id}/search/documents"
    }
  ],
  "required_environment": [
    "SIP_ENV",
    "SIP_DATABASE_URL",
    "SIP_OBJECT_STORE_BACKEND"
  ],
  "schema": "sip.service-manifest",
  "schema_version": "1.1.0",
  "security": {
    "development_auth_prohibited_in_production": true,
    "non_root_required": true,
    "read_only_root_filesystem_required": true
  },
  "service_name": "search-service"
}
