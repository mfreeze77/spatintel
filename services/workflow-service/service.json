{
  "co_location_allowed": true,
  "default_port": 8080,
  "health_paths": [
    "/health/live",
    "/health/ready",
    "/metrics"
  ],
  "logical_boundary": true,
  "operations": [
    {
      "method": "GET",
      "operation_id": "health_live",
      "path": "/health/live"
    },
    {
      "method": "GET",
      "operation_id": "health_ready",
      "path": "/health/ready"
    },
    {
      "method": "POST",
      "operation_id": "checkpoint_operation",
      "path": "/v1/internal/operations/{operation_id}/checkpoint"
    },
    {
      "method": "POST",
      "operation_id": "complete_operation",
      "path": "/v1/internal/operations/{operation_id}/complete"
    },
    {
      "method": "POST",
      "operation_id": "fail_operation",
      "path": "/v1/internal/operations/{operation_id}/fail"
    },
    {
      "method": "POST",
      "operation_id": "lease_operation",
      "path": "/v1/internal/operations/{operation_id}/lease"
    },
    {
      "method": "POST",
      "operation_id": "start_operation",
      "path": "/v1/internal/operations/{operation_id}/start"
    },
    {
      "method": "GET",
      "operation_id": "get_operation",
      "path": "/v1/operations/{operation_id}"
    },
    {
      "method": "POST",
      "operation_id": "cancel_operation",
      "path": "/v1/operations/{operation_id}/cancel"
    },
    {
      "method": "POST",
      "operation_id": "create_operation",
      "path": "/v1/projects/{project_id}/operations"
    }
  ],
  "required_environment": [
    "SIP_ENV",
    "SIP_DATABASE_URL",
    "SIP_OBJECT_STORE_BACKEND"
  ],
  "schema": "sip.service-manifest",
  "schema_version": "1.1.0",
  "security": {
    "development_auth_prohibited_in_production": true,
    "non_root_required": true,
    "read_only_root_filesystem_required": true
  },
  "service_name": "workflow-service"
}
