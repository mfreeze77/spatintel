{
  "co_location_allowed": true,
  "default_port": 8080,
  "health_paths": [
    "/health/live",
    "/health/ready",
    "/metrics"
  ],
  "logical_boundary": true,
  "operations": [
    {
      "method": "GET",
      "operation_id": "health_live",
      "path": "/health/live"
    },
    {
      "method": "GET",
      "operation_id": "health_ready",
      "path": "/health/ready"
    },
    {
      "method": "POST",
      "operation_id": "register_model",
      "path": "/v1/models"
    },
    {
      "method": "POST",
      "operation_id": "authorize_model",
      "path": "/v1/models/{model_id}/authorize"
    },
    {
      "method": "POST",
      "operation_id": "register_provider",
      "path": "/v1/providers"
    },
    {
      "method": "POST",
      "operation_id": "register_provider_capability",
      "path": "/v1/providers/capabilities"
    },
    {
      "method": "POST",
      "operation_id": "authorize_provider",
      "path": "/v1/providers/{provider_id}/authorize"
    },
    {
      "method": "GET",
      "operation_id": "get_provider_capability",
      "path": "/v1/providers/{provider_id}/capability"
    },
    {
      "method": "POST",
      "operation_id": "promote_provider_capability",
      "path": "/v1/providers/{provider_id}/promotions"
    }
  ],
  "required_environment": [
    "SIP_ENV",
    "SIP_DATABASE_URL",
    "SIP_OBJECT_STORE_BACKEND"
  ],
  "schema": "sip.service-manifest",
  "schema_version": "1.1.0",
  "security": {
    "development_auth_prohibited_in_production": true,
    "non_root_required": true,
    "read_only_root_filesystem_required": true
  },
  "service_name": "provider-registry"
}
