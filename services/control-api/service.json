{
  "co_location_allowed": true,
  "default_port": 8080,
  "health_paths": [
    "/health/live",
    "/health/ready",
    "/metrics"
  ],
  "logical_boundary": true,
  "operations": [
    {
      "method": "GET",
      "operation_id": "health_live",
      "path": "/health/live"
    },
    {
      "method": "GET",
      "operation_id": "health_ready",
      "path": "/health/ready"
    },
    {
      "method": "POST",
      "operation_id": "retest_deficiency",
      "path": "/v1/construction/deficiencies/{deficiency_id}/retest"
    },
    {
      "method": "POST",
      "operation_id": "revoke_consent",
      "path": "/v1/liveforever/consents/{grant_id}/revoke"
    },
    {
      "method": "POST",
      "operation_id": "create_comment",
      "path": "/v1/projects/{project_id}/comments"
    },
    {
      "method": "POST",
      "operation_id": "create_deficiency",
      "path": "/v1/projects/{project_id}/construction/deficiencies"
    },
    {
      "method": "POST",
      "operation_id": "attach_construction_document",
      "path": "/v1/projects/{project_id}/construction/documents"
    },
    {
      "method": "POST",
      "operation_id": "create_construction_hierarchy",
      "path": "/v1/projects/{project_id}/construction/hierarchy"
    },
    {
      "method": "GET",
      "operation_id": "get_construction_report",
      "path": "/v1/projects/{project_id}/construction/reports/{report_type}"
    },
    {
      "method": "POST",
      "operation_id": "create_construction_system",
      "path": "/v1/projects/{project_id}/construction/systems"
    },
    {
      "method": "POST",
      "operation_id": "create_conflicting_recollections",
      "path": "/v1/projects/{project_id}/liveforever/conflicting-recollections"
    },
    {
      "method": "POST",
      "operation_id": "grant_consent",
      "path": "/v1/projects/{project_id}/liveforever/consents"
    },
    {
      "method": "GET",
      "operation_id": "get_liveforever_edition",
      "path": "/v1/projects/{project_id}/liveforever/editions/{audience}"
    },
    {
      "method": "POST",
      "operation_id": "configure_liveforever_experience",
      "path": "/v1/projects/{project_id}/liveforever/experience"
    },
    {
      "method": "POST",
      "operation_id": "create_memory_record",
      "path": "/v1/projects/{project_id}/liveforever/records"
    },
    {
      "method": "POST",
      "operation_id": "create_task",
      "path": "/v1/projects/{project_id}/tasks"
    },
    {
      "method": "POST",
      "operation_id": "transition_task",
      "path": "/v1/tasks/{task_id}/transition"
    },
    {
      "method": "POST",
      "operation_id": "create_tenant",
      "path": "/v1/tenants"
    },
    {
      "method": "POST",
      "operation_id": "create_project",
      "path": "/v1/tenants/{tenant_id}/projects"
    },
    {
      "method": "GET",
      "operation_id": "get_version",
      "path": "/version"
    }
  ],
  "required_environment": [
    "SIP_ENV",
    "SIP_DATABASE_URL",
    "SIP_OBJECT_STORE_BACKEND"
  ],
  "schema": "sip.service-manifest",
  "schema_version": "1.1.0",
  "security": {
    "development_auth_prohibited_in_production": true,
    "non_root_required": true,
    "read_only_root_filesystem_required": true
  },
  "service_name": "control-api"
}
