# Atomic test-evidence staging and advisory locks
build/reports/tests/.*.lock
build/reports/tests/.*.shards.next/
build/reports/tests/.*.next.*
build/locks/
# Generated checkpoint evidence is post-commit and never authoritative source.
build/checkpoints/
build/evidence/*
build/reports/*
build/release/
build/generated/
# Keep only the documented empty evidence namespaces in clean source archives.
!build/evidence/.gitkeep
!build/reports/.gitkeep
