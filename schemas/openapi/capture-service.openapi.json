{
  "components": {
    "schemas": {
      "AssetIngest": {
        "additionalProperties": false,
        "properties": {
          "authority_class": {
            "$ref": "#/components/schemas/AuthorityClass",
            "default": "evidence"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification",
            "default": "internal"
          },
          "content_base64": {
            "title": "Content Base64",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "original_name": {
            "title": "Original Name",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceRef"
          },
          "retention_class": {
            "default": "standard",
            "title": "Retention Class",
            "type": "string"
          },
          "source_class": {
            "$ref": "#/components/schemas/SourceClass",
            "default": "direct_capture"
          }
        },
        "required": [
          "content_base64",
          "media_type",
          "original_name",
          "provenance"
        ],
        "title": "AssetIngest",
        "type": "object"
      },
      "AuthorityClass": {
        "enum": [
          "none",
          "evidence",
          "metric",
          "design",
          "visual",
          "derived_non_authoritative",
          "field_verified",
          "historical_assertion"
        ],
        "title": "AuthorityClass",
        "type": "string"
      },
      "Classification": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted",
          "critical_infrastructure",
          "biometric",
          "minor"
        ],
        "title": "Classification",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MultipartBegin": {
        "additionalProperties": false,
        "properties": {
          "expected_bytes": {
            "minimum": 0.0,
            "title": "Expected Bytes",
            "type": "integer"
          },
          "expected_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Sha256",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "default": {},
            "title": "Metadata",
            "type": "object"
          }
        },
        "required": [
          "expected_sha256",
          "expected_bytes",
          "media_type"
        ],
        "title": "MultipartBegin",
        "type": "object"
      },
      "MultipartComplete": {
        "additionalProperties": false,
        "properties": {
          "authority_class": {
            "$ref": "#/components/schemas/AuthorityClass"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "original_name": {
            "title": "Original Name",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceRef"
          },
          "retention_class": {
            "title": "Retention Class",
            "type": "string"
          },
          "source_class": {
            "$ref": "#/components/schemas/SourceClass"
          }
        },
        "required": [
          "original_name",
          "classification",
          "retention_class",
          "source_class",
          "authority_class",
          "provenance"
        ],
        "title": "MultipartComplete",
        "type": "object"
      },
      "MultipartPart": {
        "additionalProperties": false,
        "properties": {
          "content_base64": {
            "title": "Content Base64",
            "type": "string"
          },
          "expected_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Sha256",
            "type": "string"
          }
        },
        "required": [
          "content_base64",
          "expected_sha256"
        ],
        "title": "MultipartPart",
        "type": "object"
      },
      "ProvenanceRef": {
        "additionalProperties": false,
        "properties": {
          "code_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code Commit"
          },
          "container_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Container Digest"
          },
          "environment_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment Hash"
          },
          "model_checkpoint_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Checkpoint Hash"
          },
          "model_manifest_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Manifest Id"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "output_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Hash"
          },
          "parameters_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters Hash"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "validation_result_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validation Result Id"
          }
        },
        "required": [
          "source_ids"
        ],
        "title": "ProvenanceRef",
        "type": "object"
      },
      "SourceClass": {
        "enum": [
          "direct_capture",
          "observed",
          "measured",
          "verified",
          "design",
          "proposed",
          "inferred",
          "generated",
          "recalled",
          "corroborated",
          "disputed",
          "superseded"
        ],
        "title": "SourceClass",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
