{
  "components": {
    "schemas": {
      "Audience": {
        "enum": [
          "private",
          "family",
          "project",
          "owner",
          "public"
        ],
        "title": "Audience",
        "type": "string"
      },
      "Classification": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted",
          "critical_infrastructure",
          "biometric",
          "minor"
        ],
        "title": "Classification",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdentityCreate": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "identity_id": {
            "title": "Identity Id",
            "type": "string"
          },
          "identity_type": {
            "default": "user",
            "enum": [
              "user",
              "service"
            ],
            "title": "Identity Type",
            "type": "string"
          }
        },
        "required": [
          "identity_id",
          "display_name"
        ],
        "title": "IdentityCreate",
        "type": "object"
      },
      "PolicyEvaluate": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification",
            "default": "internal"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "purpose": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purpose"
          },
          "required_audience": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Audience"
              },
              {
                "type": "null"
              }
            ]
          },
          "spatial_region_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spatial Region Id"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "action",
          "tenant_id"
        ],
        "title": "PolicyEvaluate",
        "type": "object"
      },
      "RoleBind": {
        "additionalProperties": false,
        "properties": {
          "binding_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Binding Id"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "identity_id": {
            "title": "Identity Id",
            "type": "string"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "purposes": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Purposes",
            "type": "array"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "spatial_restrictions": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Spatial Restrictions",
            "type": "array"
          }
        },
        "required": [
          "identity_id",
          "role",
          "purposes"
        ],
        "title": "RoleBind",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Spatial Intelligence Platform \u2014 identity-policy",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Live",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready",
