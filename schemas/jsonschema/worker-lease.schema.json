{
  "$defs": {
    "OutputStagingScope": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "maximum_bytes": {
          "exclusiveMinimum": 0,
          "title": "Maximum Bytes",
          "type": "integer"
        },
        "mode": {
          "const": "write_only_quarantine",
          "default": "write_only_quarantine",
          "title": "Mode",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "tenant_id",
        "project_id",
        "operation_id",
        "maximum_bytes",
        "expires_at"
      ],
      "title": "OutputStagingScope",
      "type": "object"
    },
    "WorkerResourceLimits": {
      "additionalProperties": false,
      "description": "Declared execution envelope enforced by runtime and deployment controls.",
      "properties": {
        "gpu_count": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Gpu Count",
          "type": "integer"
        },
        "max_cpu_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Cpu Seconds",
          "type": "integer"
        },
        "max_input_bytes": {
          "default": 1073741824,
          "minimum": 1,
          "title": "Max Input Bytes",
          "type": "integer"
        },
        "max_memory_bytes": {
          "default": 2147483648,
          "minimum": 16777216,
          "title": "Max Memory Bytes",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 268435456,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_wall_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Wall Seconds",
          "type": "integer"
        }
      },
      "title": "WorkerResourceLimits",
      "type": "object"
    }
  },
  "$id": "https://schemas.sip.local/v1.1.0/worker-lease.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_profile": {
      "title": "Adapter Profile",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "cancellation_token": {
      "minLength": 32,
      "title": "Cancellation Token",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "input_byte_count": {
      "minimum": 0,
      "title": "Input Byte Count",
      "type": "integer"
    },
    "input_manifest": {
      "additionalProperties": true,
      "title": "Input Manifest",
      "type": "object"
    },
    "input_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Manifest Hash",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "lease_id": {
      "title": "Lease Id",
      "type": "string"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "operation_type": {
      "title": "Operation Type",
      "type": "string"
    },
    "output_staging_scope": {
      "$ref": "#/$defs/OutputStagingScope"
    },
    "resource_limits": {
      "$ref": "#/$defs/WorkerResourceLimits"
    },
    "resume_checkpoint": {
      "additionalProperties": true,
      "title": "Resume Checkpoint",
      "type": "object"
    },
    "resume_progress": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Resume Progress",
      "type": "number"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sip.worker-lease/v1",
      "default": "sip.worker-lease/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "traceparent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    },
    "worker_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Worker Manifest Sha256",
      "type": "string"
    },
    "workload_identity": {
      "title": "Workload Identity",
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "run_id",
    "operation_id",
    "attempt",
    "operation_type",
    "adapter_profile",
    "input_manifest",
    "input_manifest_hash",
    "input_byte_count",
    "output_staging_scope",
    "resource_limits",
    "deadline_at",
    "cancellation_token",
    "workload_identity",
    "capabilities",
    "worker_manifest_sha256",
    "issued_at",
    "expires_at"
  ],
  "title": "WorkerLease",
  "type": "object"
}
