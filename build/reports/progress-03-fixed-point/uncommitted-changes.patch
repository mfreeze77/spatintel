+def _safe_pydantic_errors(errors: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    safe: list[dict[str, Any]] = []
+    for item in errors[:25]:
+        safe.append({
+            "loc": [str(value) for value in item.get("loc", [])],
